const ACTIVE_SECTION_KEY = "souls-gate-ds3-active-section";

export default function DarkSoulsThreePage() {
  const [active, setActive] = useState("rings");
  const [activeLoaded, setActiveLoaded] = useState(false);
  const [sectionSearch, setSectionSearch] = useState("");

  useEffect(() => {
    const audio = new Audio("/audio/ds3-intro.mp3");
    audio.preload = "auto";
    audio.volume = 0.35;
    audio.loop = false;

    let cancelled = false;
    let started = false;
    let ready = false;
    let delayPassed = false;

    const tryPlay = () => {
      if (cancelled || started || !ready || !delayPassed) return;
      started = true;
      audio.currentTime = 0;
      void audio.play().catch(() => {
        started = false;
      });
    };

    const onReady = () => {
      ready = true;
      tryPlay();
    };

    audio.addEventListener("canplay", onReady);
    audio.load();

    const timer = window.setTimeout(() => {
      delayPassed = true;
      tryPlay();
    }, 1000);

    return () => {
      cancelled = true;
      window.clearTimeout(timer);
      audio.removeEventListener("canplay", onReady);
      audio.pause();
      audio.currentTime = 0;
    };
  }, []);

  // بازیابی آخرین بخش انتخاب‌شده پس از بارگذاری یا رفرش
  useEffect(() => {
    try {
      const savedSection = window.localStorage.getItem(ACTIVE_SECTION_KEY);
      if (savedSection && sections.some((section) => section.id === savedSection)) {
        setActive(savedSection);
      }
    } catch (error) {
      console.error("Could not restore active section:", error);
    } finally {
      setActiveLoaded(true);
    }
  }, []);

  // ذخیره بخش انتخاب‌شده
  useEffect(() => {
    if (!activeLoaded) return;
    try {
      window.localStorage.setItem(ACTIVE_SECTION_KEY, active);
    } catch (error) {
      console.error("Could not save active section:", error);
    }
  }, [active, activeLoaded]);

  const current = sections.find((item) => item.id === active) ?? sections[0];

  const filteredSections = useMemo(() => {
    const query = sectionSearch.trim().toLowerCase();
    if (!query) return sections;
    return sections.filter((item) =>
      `${item.title} ${item.fa} ${item.number}`.toLowerCase().includes(query)
    );
  }, [sectionSearch]);

  const selectSection = (id: string) => {
    setActive(id);
    setSectionSearch("");
