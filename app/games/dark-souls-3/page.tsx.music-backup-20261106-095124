                <div className="font-serif text-5xl text-[#c8a15b]">{current.icon}</div>
                <h3 className="mt-5 font-serif text-2xl">{current.title}</h3>
                <p dir="rtl" className="mt-3 text-sm leading-8 text-white/65">
                  این بخش هنوز آماده نشده است.
                </p>
              </div>
            )}
          </div>
        </div>
      </section>

      {/* Footer */}
      <footer className="border-t border-[#c8a15b]/30 bg-black/90 px-6 py-8 text-center">
        <p className="font-serif text-sm tracking-[0.25em] text-[#d8b66e]">
          SOULS GATE
        </p>
        <p className="mt-2 text-[9px] tracking-[0.2em] text-white/45">
          MAY THE FLAMES GUIDE THEE
        </p>
        <button
          type="button"
          onClick={() => window.scrollTo({ top: 0, behavior: "smooth" })}
          className="mt-5 border border-white/15 px-4 py-2 text-[10px] tracking-[0.12em] text-white/65 transition hover:border-[#c8a15b]/60 hover:text-[#d8b66e]"
        >
          BACK TO TOP ↑
        </button>
      </footer>
    </main>
  );
}

